# build.cmake - configure, build, test, install and package a CMake project on Windows and Linux,
# with the generator chosen automatically.
#
#   cmake -P cmake/build.cmake -- [-S <src>] [-B <build>] [--config <cfg>] [--prefix <dir>]
#                                 [--package] [--clean] [-G <generator>] [-D<VAR>=<value>...]
#
#   -S / -B     source / build directory (default: . / build)
#   --config    Debug | Release | RelWithDebInfo | MinSizeRel (default: Release)
#   --prefix    install into <dir> after the tests
#   --package   create packages with CPack into <build>/packages (the project must include(package))
#   --clean     delete the build directory first (needed to switch generators)
#   -G          use this generator instead of detecting one
#   -D          passed to CMake; relative paths in CMAKE_PREFIX_PATH, CMAKE_INSTALL_PREFIX,
#               CMAKE_TOOLCHAIN_FILE, *_ROOT and *_DIR are made absolute
#
# Generator detection:
#   Windows  newest Visual Studio with C++ tools (vswhere) -> "Visual Studio NN YYYY" -A x64|ARM64.
#            If this cmake is too old for it, the cmake bundled with Visual Studio is used.
#            Without Visual Studio: Ninja, else MinGW Makefiles (g++ on PATH).
#   Linux    Ninja, else Unix Makefiles.
# An existing build directory keeps the generator and cmake it was created with.

cmake_minimum_required(VERSION 3.21)

# ---------------------------------------------------------------------------------------------------------
# Arguments (everything after "--")

set(source_dir .)
set(build_dir build)
set(config Release)
set(prefix "")
set(generator "")
set(clean FALSE)
set(package FALSE)
set(defines "")

set(args "")
set(after_separator FALSE)
math(EXPR last_arg "${CMAKE_ARGC} - 1")
foreach(i RANGE 1 ${last_arg})
    if(after_separator)
        list(APPEND args "${CMAKE_ARGV${i}}")
    elseif(CMAKE_ARGV${i} STREQUAL "--")
        set(after_separator TRUE)
    endif()
endforeach()

while(args)
    list(POP_FRONT args arg)
    if(arg MATCHES "^(-S|-B|--config|--prefix|-G)$")
        if(NOT args)
            message(FATAL_ERROR "${arg} needs a value")
        endif()
        list(POP_FRONT args value)
        if(arg STREQUAL "-S")
            set(source_dir "${value}")
        elseif(arg STREQUAL "-B")
            set(build_dir "${value}")
        elseif(arg STREQUAL "--config")
            set(config "${value}")
        elseif(arg STREQUAL "--prefix")
            set(prefix "${value}")
        else()
            set(generator "${value}")
        endif()
    elseif(arg STREQUAL "--clean")
        set(clean TRUE)
    elseif(arg STREQUAL "--package")
        set(package TRUE)
    elseif(arg MATCHES "^-D([^:=]+)(:[A-Z]+)?=(.*)$")
        set(var "${CMAKE_MATCH_1}")
        set(type "${CMAKE_MATCH_2}")
        set(value "${CMAKE_MATCH_3}")
        # CMake would not resolve these against the current directory
        if(var MATCHES "^(CMAKE_PREFIX_PATH|CMAKE_INSTALL_PREFIX|CMAKE_TOOLCHAIN_FILE)$|_(ROOT|DIR)$"
                AND value AND NOT IS_ABSOLUTE "${value}")
            get_filename_component(value "${value}" ABSOLUTE)
        endif()
        list(APPEND defines "-D${var}${type}=${value}")
    else()
        message(FATAL_ERROR "Unknown argument '${arg}'. Usage: see the top of ${CMAKE_CURRENT_LIST_FILE}")
    endif()
endwhile()

get_filename_component(source_dir "${source_dir}" ABSOLUTE)
get_filename_component(build_dir "${build_dir}" ABSOLUTE)
if(prefix)
    get_filename_component(prefix "${prefix}" ABSOLUTE)
endif()
if(NOT EXISTS "${source_dir}/CMakeLists.txt")
    message(FATAL_ERROR "No CMakeLists.txt in ${source_dir}")
endif()
if(clean)
    file(REMOVE_RECURSE "${build_dir}")
endif()

# ---------------------------------------------------------------------------------------------------------
# Generator and cmake executable

# TRUE if <cmake_exe> supports <generator>
function(cmake_supports cmake_exe generator out)
    execute_process(COMMAND "${cmake_exe}" -E capabilities OUTPUT_VARIABLE caps ERROR_QUIET)
    string(JSON count ERROR_VARIABLE err LENGTH "${caps}" generators)
    set(found FALSE)
    if(NOT err AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON name GET "${caps}" generators ${i} name)
            if(name STREQUAL generator)
                set(found TRUE)
            endif()
        endforeach()
    endif()
    set(${out} ${found} PARENT_SCOPE)
endfunction()

# Visual Studio installations with C++ tools as "<version>|<path>", newest first
function(visual_studio_installs out)
    set(pf86 "ProgramFiles(x86)") # parentheses cannot be written inside $ENV{}
    set(vswhere "$ENV{${pf86}}/Microsoft Visual Studio/Installer/vswhere.exe")
    set(installs "")
    if(EXISTS "${vswhere}")
        execute_process(COMMAND "${vswhere}" -all -products * -format json -utf8
                -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
                OUTPUT_VARIABLE json ERROR_QUIET)
        string(JSON count ERROR_VARIABLE err LENGTH "${json}")
        if(NOT err AND count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(i RANGE ${last})
                string(JSON version GET "${json}" ${i} installationVersion)
                string(JSON path GET "${json}" ${i} installationPath)
                file(TO_CMAKE_PATH "${path}" path)
                list(APPEND installs "${version}|${path}")
            endforeach()
        endif()
        list(SORT installs COMPARE NATURAL ORDER DESCENDING)
    endif()
    set(${out} "${installs}" PARENT_SCOPE)
endfunction()

set(cmake_exe "${CMAKE_COMMAND}")
set(platform "")
if(CMAKE_HOST_WIN32 AND "$ENV{PROCESSOR_ARCHITECTURE}" STREQUAL "ARM64")
    set(vs_arch ARM64)
else()
    set(vs_arch x64)
endif()
set(cache "${build_dir}/CMakeCache.txt")

if(EXISTS "${cache}")
    # Reuse what the build directory was created with
    file(STRINGS "${cache}" generator REGEX "^CMAKE_GENERATOR:INTERNAL=")
    file(STRINGS "${cache}" cached_cmake REGEX "^CMAKE_COMMAND:INTERNAL=")
    string(REGEX REPLACE "^[^=]*=" "" generator "${generator}")
    string(REGEX REPLACE "^[^=]*=" "" cached_cmake "${cached_cmake}")
    if(EXISTS "${cached_cmake}")
        set(cmake_exe "${cached_cmake}")
    endif()
elseif(generator)
    if(generator MATCHES "^Visual Studio")
        set(platform ${vs_arch})
    endif()
elseif(CMAKE_HOST_WIN32)
    visual_studio_installs(installs)
    # This cmake first, then the ones bundled with Visual Studio
    set(cmakes "${CMAKE_COMMAND}")
    foreach(install IN LISTS installs)
        string(REGEX REPLACE "^[^|]*\\|" "" path "${install}")
        set(bundled "${path}/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe")
        if(EXISTS "${bundled}")
            list(APPEND cmakes "${bundled}")
        endif()
    endforeach()
    set(vs_generators 15 "Visual Studio 15 2017" 16 "Visual Studio 16 2019"
                      17 "Visual Studio 17 2022" 18 "Visual Studio 18 2026")
    foreach(install IN LISTS installs)
        string(REGEX MATCH "^[0-9]+" major "${install}")
        list(FIND vs_generators "${major}" index)
        if(index EQUAL -1)
            continue()
        endif()
        math(EXPR index "${index} + 1")
        list(GET vs_generators ${index} vs_generator)
        foreach(candidate IN LISTS cmakes)
            cmake_supports("${candidate}" "${vs_generator}" ok)
            if(ok)
                set(generator "${vs_generator}")
                set(platform ${vs_arch})
                set(cmake_exe "${candidate}")
                break()
            endif()
        endforeach()
        if(generator)
            break()
        endif()
    endforeach()
    if(NOT generator)
        find_program(ninja_exe ninja)
        find_program(gxx_exe g++)
        if(ninja_exe)
            set(generator "Ninja")
        elseif(gxx_exe)
            set(generator "MinGW Makefiles")
        else()
            message(FATAL_ERROR "No Visual Studio with C++ tools, and no ninja or MinGW g++ on PATH")
        endif()
    endif()
else()
    find_program(ninja_exe NAMES ninja ninja-build)
    if(ninja_exe)
        set(generator "Ninja")
    else()
        set(generator "Unix Makefiles")
    endif()
endif()

# ctest / cpack of the same CMake installation (on Windows, Chocolatey also ships an unrelated cpack.exe)
get_filename_component(cmake_dir "${cmake_exe}" DIRECTORY)
foreach(tool ctest cpack)
    find_program(${tool}_exe ${tool} HINTS "${cmake_dir}" NO_DEFAULT_PATH)
    if(NOT ${tool}_exe)
        set(${tool}_exe ${tool})
    endif()
endforeach()

if(platform)
    message(STATUS "Generator: ${generator} (-A ${platform})")
else()
    message(STATUS "Generator: ${generator}")
endif()
message(STATUS "CMake    : ${cmake_exe}")
message(STATUS "Config   : ${config}")

# ---------------------------------------------------------------------------------------------------------
# Configure, build, test, install, package

function(run)
    execute_process(COMMAND ${ARGN} COMMAND_ECHO STDOUT RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result})")
    endif()
endfunction()

set(configure -S "${source_dir}" -B "${build_dir}")
if(NOT EXISTS "${cache}")
    list(APPEND configure -G "${generator}")
    if(platform)
        list(APPEND configure -A ${platform})
    endif()
endif()
if(NOT generator MATCHES "^Visual Studio|Multi-Config$|^Xcode$")
    list(APPEND configure "-DCMAKE_BUILD_TYPE=${config}") # single-config generators: set at configure time
endif()

run("${cmake_exe}" ${configure} ${defines})
run("${cmake_exe}" --build "${build_dir}" --config ${config} --parallel)
if(EXISTS "${build_dir}/CTestTestfile.cmake")
    run("${ctest_exe}" --test-dir "${build_dir}" -C ${config} --output-on-failure)
endif()
if(prefix)
    run("${cmake_exe}" --install "${build_dir}" --config ${config} --prefix "${prefix}")
endif()
if(package)
    if(NOT EXISTS "${build_dir}/CPackConfig.cmake")
        message(FATAL_ERROR "No CPackConfig.cmake: add include(package) to the project's CMakeLists.txt")
    endif()
    run("${cpack_exe}" --config "${build_dir}/CPackConfig.cmake" -C ${config})
endif()
